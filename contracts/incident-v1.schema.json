{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentLab team contract v1.0",
  "description": "Proposed development interface. Shape validation is not payment authorization.",
  "$defs": {
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_local_order"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "OK"
            },
            "data": {
              "type": "object",
              "properties": {
                "order_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_order_id": {
                  "type": "string",
                  "minLength": 1
                },
                "payment_state": {
                  "type": "string",
                  "enum": [
                    "UNCONFIRMED",
                    "PAID"
                  ]
                },
                "currency": {
                  "type": "string",
                  "enum": [
                    "USD"
                  ]
                },
                "amount": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d{2}$"
                },
                "capture_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fulfillment_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "order_id",
                "provider_order_id",
                "payment_state",
                "currency",
                "amount",
                "capture_id",
                "fulfillment_count"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_local_order"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "ERROR"
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "UNAVAILABLE",
                    "TIMEOUT",
                    "INVALID_RESPONSE"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_paypal_order"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "OK"
            },
            "data": {
              "type": "object",
              "properties": {
                "provider_order_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "CREATED",
                    "APPROVED",
                    "COMPLETED",
                    "VOIDED",
                    "PAYER_ACTION_REQUIRED",
                    "UNKNOWN"
                  ]
                },
                "purchase_unit": {
                  "type": "object",
                  "properties": {
                    "provider_order_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "custom_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "USD"
                      ]
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d{2}$"
                    }
                  },
                  "required": [
                    "provider_order_id",
                    "custom_id",
                    "currency",
                    "amount"
                  ],
                  "additionalProperties": false
                },
                "captures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "capture_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "COMPLETED",
                          "PENDING",
                          "DECLINED",
                          "FAILED",
                          "REFUNDED",
                          "PARTIALLY_REFUNDED",
                          "UNKNOWN"
                        ]
                      },
                      "currency": {
                        "type": "string",
                        "enum": [
                          "USD"
                        ]
                      },
                      "amount": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d{2}$"
                      }
                    },
                    "required": [
                      "capture_id",
                      "status",
                      "currency",
                      "amount"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "provider_order_id",
                "status",
                "purchase_unit",
                "captures"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_paypal_order"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "ERROR"
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "UNAVAILABLE",
                    "TIMEOUT",
                    "INVALID_RESPONSE"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_application_events"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "OK"
            },
            "data": {
              "type": "object",
              "properties": {
                "coverage": {
                  "type": "string",
                  "enum": [
                    "COMPLETE",
                    "PARTIAL",
                    "UNAVAILABLE"
                  ]
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "event": {
                        "type": "string",
                        "enum": [
                          "CAPTURE_NOT_SENT",
                          "CAPTURE_DISPATCHED",
                          "LOCAL_CONFIRMATION_SAVED",
                          "LOCAL_CONFIRMATION_UNAVAILABLE"
                        ]
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "event",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "coverage",
                "events"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "const": "get_application_events"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "const": "ERROR"
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "UNAVAILABLE",
                    "TIMEOUT",
                    "INVALID_RESPONSE"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "evidence_id",
            "tool",
            "observed_at",
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence_bundle": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "offline",
            "sandbox"
          ]
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "symptom": {
          "const": "Checkout could not be confirmed"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "contract_version",
        "mode",
        "incident_id",
        "order_id",
        "symptom",
        "observations"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "reconcile_order",
            "capture_approved_order",
            "escalate"
          ]
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "decision_id",
        "action",
        "order_id",
        "summary",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "reconcile_order",
            "capture_approved_order",
            "escalate"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "BLOCKED",
            "FAILED",
            "UNKNOWN",
            "NOT_EXECUTED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "decision_id",
        "action",
        "status",
        "message"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "NOT_VERIFIED",
            "INCONCLUSIVE"
          ]
        },
        "provider_order_id": {
          "type": "string",
          "minLength": 1
        },
        "completed_capture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_payment_state": {
          "type": "string",
          "enum": [
            "UNCONFIRMED",
            "PAID"
          ]
        },
        "fulfillment_count": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "provider_payment_completed",
                  "order_identity_matches",
                  "amount_currency_match",
                  "local_state_matches",
                  "single_fulfillment"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "provider_order_id",
        "completed_capture_id",
        "local_payment_state",
        "fulfillment_count",
        "checks"
      ],
      "additionalProperties": false
    },
    "incident_run": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "type": "string",
          "enum": [
            "agent",
            "rules",
            "manual"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence_bundle"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "type": "string",
                "enum": [
                  "detected",
                  "tool_result",
                  "decision",
                  "execution",
                  "verification"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "sequence",
              "stage",
              "summary",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_version",
        "run_id",
        "controller",
        "evidence",
        "decision",
        "execution",
        "verification",
        "timeline"
      ],
      "additionalProperties": false
    },
    "tool_request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "enum": [
            "get_local_order",
            "get_paypal_order",
            "get_application_events"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "order_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/evidence_bundle"
    },
    {
      "$ref": "#/$defs/incident_run"
    },
    {
      "$ref": "#/$defs/tool_request"
    }
  ]
}
